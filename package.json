{
  "name": "anininja",
  "productName": "AniNinja",
  "version": "1.1.3",
  "description": "Personal anime browsing and streaming desktop app",
  "main": "main.js",
  "author": "richa <richa@localhost>",
  "license": "MIT",
  "homepage": "https://github.com/RichardPersaud/AniBrowser",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb",
    "release": "electron-builder --win nsis -p always"
  },
  "build": {
    "appId": "io.local.anibrowser",
    "productName": "AniNinja",
    "publish": {
      "provider": "github",
      "owner": "RichardPersaud",
      "repo": "AniBrowser"
    },
    "files": [
      "main.js",
      "server.js",
      "cloud.js",
      "scraper.js",
      "updater.js",
      "ui/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AniNinja"
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pngjs": "^7.0.0"
  }
}

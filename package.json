{
  "name": "anime-player",
  "productName": "AniBrowser",
  "version": "1.0.13",
  "description": "Personal anime browsing and streaming desktop app",
  "main": "main.js",
  "author": "richa",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "io.local.anibrowser",
    "productName": "AniBrowser",
    "files": [
      "main.js",
      "server.js",
      "scraper.js",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AniBrowser"
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "ws": "^8.21.3"
  }
}
